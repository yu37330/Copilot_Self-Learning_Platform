{
  "schema_version": "1.0",
  "record_type": "agentcore-memory-design-not-api-request",
  "status": "proposal_not_deployed",
  "external_transfer_authorized": false,
  "region": "company_approved_region_to_be_verified",
  "isolation": {
    "resource_per": ["project", "experiment_variant", "environment"],
    "actor_id": "stable_pseudonymous_developer_id",
    "session_id": "one_logical_development_task"
  },
  "native_baseline": {
    "episodic": true,
    "semantic": false,
    "summary": false,
    "user_preference": false,
    "prompt_overrides": false
  },
  "candidate_profile": {
    "episodic": true,
    "episodic_prompt_overrides": "compare_after_native_baseline",
    "semantic": "optional_for_user_confirmed_environment_and_project_facts",
    "summary": "optional_for_long_session_resumption",
    "user_preference": "off_until_personalization_is_needed"
  },
  "proposed_retention": {
    "eventExpiryDuration": 30,
    "long_term_days": 90,
    "long_term_parameter": "recordExpirySpecification.recordExpiryDurationDays",
    "deployment_gate": "verify_target_sdk_and_service_support_and_iam_before_use",
    "s3_lifecycle": "separate_company_retention_policy"
  },
  "namespace_templates": {
    "episodes": "/strategy/{memoryStrategyId}/actor/{actorId}/session/{sessionId}/",
    "reflections": "/strategy/{memoryStrategyId}/actor/{actorId}/",
    "semantic": "/facts/{memoryStrategyId}/actor/{actorId}/"
  },
  "retrieval_proposal": {
    "topK_reflections": 3,
    "topK_episodes": 3,
    "topK_semantic": 2,
    "filter_by_strategy": true,
    "namespace_must_be_derived_by_trusted_application": true,
    "use_metadata_only_after_verified_schema": true,
    "default_namespace_root_forbidden_by_design": true
  },
  "required_input": ["task", "observed_actions", "tool_results", "test_results", "user_corrections", "success_failure_unknown"],
  "non_goals": ["model_weight_training", "copilot_auto_install", "workflow_execution", "automatic_transfer_authorization"]
}
